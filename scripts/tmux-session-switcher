#!/usr/bin/env bash
# ~/.local/bin/tmux-session-switcher

# Liste toutes les sessions et permet de switcher avec fzf
session=$(tmux list-sessions -F "#{session_name}" 2>/dev/null | fzf --height 40% --reverse --border --prompt="Switch to session: ")

if [[ -n $session ]]; then
    tmux switch-client -t "$session"
fi
