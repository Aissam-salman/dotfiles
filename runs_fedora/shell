#!/usr/bin/env bash

echo "========================================"
echo "Installation complète du Shell (Fedora)"
echo "========================================"
echo ""

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Array of scripts to run
scripts=(
    "$SCRIPT_DIR/shell_01_zsh"
    "$SCRIPT_DIR/shell_02_oh_my_zsh"
    "$SCRIPT_DIR/shell_03_starship"
    "$SCRIPT_DIR/shell_04_config"
    "$SCRIPT_DIR/shell_05_default"
)

# Run each script
for script in "${scripts[@]}"; do
    echo ""
    if [ -f "$script" ]; then
        bash "$script"
        if [ $? -ne 0 ]; then
            echo "❌ Erreur lors de l'exécution de $script"
            exit 1
        fi
    else
        echo "❌ Erreur: $script non trouvé"
        exit 1
    fi
done

echo ""
echo "========================================"
echo "✅ Installation shell terminée (Fedora)"
echo "========================================"
