#!/usr/bin/env bash

set -e  # Exit on error

echo "================================"
echo "Étape 5: Définir zsh par défaut"
echo "================================"

sudo chsh -s $(which zsh) $USER

echo "✅ zsh est maintenant défini comme shell par défaut"
echo "⚠️  Vous devrez vous reconnecter pour que le changement soit effectif"
