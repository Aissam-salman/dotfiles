#!/usr/bin/env bash

echo "Install Obsidian 📝"
# Obsidian via COPR (unofficial but reliable)
sudo dnf copr enable -y lukelbd/obsidian
sudo dnf install -y obsidian

# Alternative: Use Flatpak if COPR doesn't work
# flatpak install flathub md.obsidian.Obsidian

echo "Done installation success Obsidian 📝"