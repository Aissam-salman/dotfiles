#!/usr/bin/env bash

# Installer les outils de développement de base
sudo dnf install -y rpm-build

# Applications graphiques
sudo dnf install -y gimp dolphin rofi

# Dev tools et languages
sudo dnf install -y nodejs npm
# language support C and CPP
sudo dnf install -y clang llvm lld cmake gdb lldb

# Terminal utils
sudo dnf install -y tldr fzf btop bc tmux curl wget \
fd-find ripgrep bat  zoxide unzip xclip

# Wayland/Qt support
sudo dnf install -y qt5-qtwayland qt6-qtwayland

# Audio (Pipewire - déjà installé par défaut sur Fedora)
sudo dnf install -y pipewire wireplumber

# Notifications
sudo dnf install -y mako

# Fonts
sudo dnf install -y fontconfig google-noto-fonts \
google-noto-emoji-fonts google-noto-sans-fonts google-noto-serif-fonts

# stylua via cargo (pas dans les repos Fedora)
if ! command -v stylua &> /dev/null; then
    echo "📦 stylua: installer via cargo install stylua (nécessite rust)"
    cargo install stylua
fi

echo "✅ Installation dev tools terminée (Fedora)"
