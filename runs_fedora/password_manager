#!/usr/bin/env bash

echo "install Bitwarden Desktop"
# Bitwarden via COPR (unofficial but reliable)
sudo dnf copr enable -y lukelbd/bitwarden
sudo dnf install -y bitwarden

# Alternative: Use Flatpak if COPR doesn't work
# flatpak install flathub com.bitwarden.desktop

echo "Done installation success Bitwarden Desktop"

