#!/usr/bin/env bash

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

filter=""
dry="0"
distro="arch"  # Par défaut: arch

while [[ $# > 0 ]]; do
    case "$1" in
        --dry)
            dry="1"
            ;;
        --distro)
            shift
            distro="$1"
            ;;
        *)
            filter="$1"
            ;;
    esac
    shift
done

log() {
    if [[ $dry == "1" ]]; then
        echo "[DRY_RUN]: $@"
    else
        echo "$@"
    fi
}

execute() {
    log "execute $@"
    if [[ $dry == "1" ]]; then
        echo "[DRY_RUN]: $@"
    fi
    "$@"
}

runs_dir="runs_${distro}"

# Vérifier que le dossier existe
if [[ ! -d "$runs_dir" ]]; then
    echo "❌ Erreur: Le dossier '$runs_dir' n'existe pas"
    echo "💡 Distros disponibles: arch, fedora"
    echo "Usage: ./run [--distro <arch|fedora>] [--dry] [filter]"
    exit 1
fi

log "📦 Distro: $distro -- Dossier: $runs_dir -- Filtre: ${filter:-aucun}"

cd "$script_dir" || exit 1

find "$runs_dir" -maxdepth 1 -mindepth 1 -executable -type f | while read -r script; do
    if [[ -n  "$filter" && "$script" != *"$filter"* ]]; then
        log "filtered: $filter -- $script"
        continue
    fi
    execute "./$script"
done
